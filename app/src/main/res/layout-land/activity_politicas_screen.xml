<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:background="#9EC3C6">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtTituloPrivacidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ExtendedPrivaciPolitics"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#006064"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:text="@string/copyright"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#00796B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/copyrightText"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/introduction"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#00796B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/textoCompromiso1"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/InformationRecopilation"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#00796B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/InformationRecopilationText"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/InformationUse"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#00796B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/InformationUseText"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/DataShare"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#00796B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/DataShareText"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/Security"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#00796B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/SecurityText"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <!-- Sección 5 -->
                    <TextView
                        android:text="@string/UserRights"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#00796B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/UserRightsText"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/PoliticChanges"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#00796B"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="@string/PoliticChangesText"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>